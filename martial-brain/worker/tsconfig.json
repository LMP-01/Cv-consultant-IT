{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,

    // Worker runtime, not Node and not the DOM: D1Database, ExportedHandler and
    // the Workers flavour of the Web Crypto typings all come from here.
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["."]
}

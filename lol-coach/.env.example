# ── Coach IA — configuration ──────────────────────────────────────────────
# Copie ce fichier en `.env` et adapte les valeurs. Toutes sont optionnelles :
# l'appli fonctionne sans aucune clé grâce au moteur de règles local.

# Port du serveur web local (interface HTML).
PORT=3000

# Langue de l'interface et des conseils (fr / en).
# (variable dédiée — on ne lit pas la variable système POSIX `LANG`)
LANG_UI=fr

# ── Moteur IA (optionnel) ─────────────────────────────────────────────────
# Backend des conseils IA :
#   auto        -> clé API si présente, sinon abonnement (Claude Code), sinon règles
#   claude-code -> ton abonnement Claude Max/Pro via la CLI `claude` (SANS clé API)
#   api         -> clé API Anthropic (facturation au token)
#   rules       -> moteur de règles local uniquement (aucun appel)
AI_PROVIDER=auto

# ── Option A : abonnement Claude Max/Pro (sans clé API) ────────────────────
# Nécessite Claude Code installé et connecté à ton compte :
#   npm install -g @anthropic-ai/claude-code   (ou voir code.claude.com)
#   claude            # puis /login   (connecte ton abonnement)
#   claude setup-token  # alternative : génère un token longue durée
# Si tu utilises un token : décommente la ligne suivante avec ta valeur.
# CLAUDE_CODE_OAUTH_TOKEN=
# IMPORTANT : pour utiliser l'abonnement, NE définis PAS ANTHROPIC_API_KEY
# (elle aurait la priorité). L'app la retire automatiquement pour ces appels.
# Modèle via l'abonnement (sonnet par défaut = léger pour le quota Max ; 'opus'
# possible mais épuise plus vite ton quota en temps réel).
CLAUDE_CODE_MODEL=sonnet

# ── Option B : clé API Anthropic (facturation au token) ────────────────────
# Obtenir une clé : https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modèle pour le backend API (par défaut le plus capable).
CLAUDE_MODEL=claude-opus-4-8

# Intervalle minimum (secondes) entre deux appels IA pendant une partie,
# pour maîtriser le quota/coût et la latence.
AI_MIN_INTERVAL_SECONDS=12

# ── Riot Games API (optionnel) ────────────────────────────────────────────
# Active l'enrichissement par la Riot API (rangs/historique des adversaires).
# Non requis : le champ select et l'in-game passent par les API LOCALES.
# Clé dev (EXPIRE TOUTES LES 24 h — régénère-la chaque jour) :
#   https://developer.riotgames.com/   (bouton "Regenerate API Key")
RIOT_API_KEY=
# Région de routage régional pour la Riot API (europe, americas, asia).
RIOT_REGION=europe
# Plateforme (euw1, eun1, na1, kr, ...).
RIOT_PLATFORM=euw1
# Ton Riot ID "Pseudo#TAG" — pour le suivi de rang/LP et l'historique réel.
RIOT_ID=
# Gain net moyen de LP par victoire (estimation du nb de games à win pour Master).
RANK_LP_PER_WIN=22

# ── Avancé ────────────────────────────────────────────────────────────────
# Chemin d'installation de League of Legends (pour trouver le lockfile LCU).
# Laisse vide pour autodétection (chemins par défaut + scan du process).
# Exemple Windows : C:\Riot Games\League of Legends
LEAGUE_PATH=

# Locale Data Dragon pour les noms de champions/items (fr_FR, en_US, ...).
DDRAGON_LOCALE=fr_FR

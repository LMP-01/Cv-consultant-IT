# ── Coach IA — configuration ──────────────────────────────────────────────
# Copie ce fichier en `.env` et adapte les valeurs. Toutes sont optionnelles :
# l'appli fonctionne sans aucune clé grâce au moteur de règles local.

# Port du serveur web local (interface HTML).
PORT=3000

# Langue de l'interface et des conseils (fr / en).
# (variable dédiée — on ne lit pas la variable système POSIX `LANG`)
LANG_UI=fr

# ── Moteur IA (optionnel) ─────────────────────────────────────────────────
# Clé API Anthropic pour des conseils générés par Claude. Sans clé, l'appli
# bascule automatiquement sur le moteur de règles local (heuristiques).
# Obtenir une clé : https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modèle Claude à utiliser. Par défaut le plus capable (claude-opus-4-8).
# Pour des conseils plus rapides en jeu, tu peux passer à claude-haiku-4-5.
CLAUDE_MODEL=claude-opus-4-8

# Intervalle minimum (secondes) entre deux appels IA pendant une partie,
# pour maîtriser le coût et la latence.
AI_MIN_INTERVAL_SECONDS=12

# ── Riot Games API (optionnel) ────────────────────────────────────────────
# Active l'enrichissement par la Riot API (rangs/historique des adversaires).
# Non requis : le champ select et l'in-game passent par les API LOCALES.
# Clé dev (24h) : https://developer.riotgames.com/
RIOT_API_KEY=
# Région de routage régional pour la Riot API (europe, americas, asia).
RIOT_REGION=europe
# Plateforme (euw1, eun1, na1, kr, ...).
RIOT_PLATFORM=euw1

# ── Avancé ────────────────────────────────────────────────────────────────
# Chemin d'installation de League of Legends (pour trouver le lockfile LCU).
# Laisse vide pour autodétection (chemins par défaut + scan du process).
# Exemple Windows : C:\Riot Games\League of Legends
LEAGUE_PATH=

# Locale Data Dragon pour les noms de champions/items (fr_FR, en_US, ...).
DDRAGON_LOCALE=fr_FR
